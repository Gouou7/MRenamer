{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MRenamer",
  "version": "0.0.0",
  "identifier": "dev.govo.mrenamer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MRenamer",
        "decorations": false,
        "visible": false,
        "width": 1440,
        "height": 940,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Batch file and folder renaming",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
